+    function formatDateTime(value) {
+      if (!value) return "—";
+      const date = new Date(value);
+      if (Number.isNaN(date.getTime())) return "—";
+      return date.toLocaleString();
+    }
+
+    function auditActionLabel(action) {
+      const labels = {
+        "user.plan.changed": "Plan changed",
+        "complimentary_top_tier.granted": "Gift TOP granted",
+        "complimentary_top_tier.revoked": "Gift TOP revoked"
+      };
+
+      return labels[action] || action || "Unknown action";
+    }
+
+    function auditDetailsText(details) {
+      if (!details || typeof details !== "object") return "—";
+
+      const parts = [];
+      if (details.previousPlanTier || details.newPlanTier) {
+        parts.push(
+          `${details.previousPlanTier || "—"} → ${details.newPlanTier || "—"}`
+        );
+      }
+      if (details.slot) parts.push(`slot #${details.slot}`);
+      if (details.removedComplimentarySlot) {
+        parts.push(`removed gift slot #${details.removedComplimentarySlot}`);
+      }
+      if (details.resultingPlanTier) {
+        parts.push(`result: ${details.resultingPlanTier}`);
+      }
+
+      return parts.length ? parts.join(" · ") : "—";
+    }
+
+    function renderAudit() {
+      if (!auditEvents.length) {
+        auditBody.innerHTML =
+          '<tr><td colspan="5" class="loading">No administrator actions have been recorded yet.</td></tr>';
+        return;
+      }
+
+      auditBody.innerHTML = auditEvents.map((event) => `
+        <tr>
+          <td>${escapeHtml(formatDateTime(event.createdAt))}</td>
+          <td>${escapeHtml(event.adminEmail || "—")}</td>
+          <td><span class="badge gold">${escapeHtml(auditActionLabel(event.action))}</span></td>
+          <td>${escapeHtml(event.targetEmail || "—")}</td>
+          <td>${escapeHtml(auditDetailsText(event.details))}</td>
+        </tr>
+      `).join("");
+    }
+
+    async function loadAudit() {
+      try {
+        const result = await api("/api/admin/audit?limit=100");
+        auditEvents = Array.isArray(result.events) ? result.events : [];
+        renderAudit();
+        setFeedback(auditFeedback, `Showing ${auditEvents.length} recent action${auditEvents.length === 1 ? "" : "s"}.`, "ok");
+      } catch (error) {
+        auditBody.innerHTML =
+          `<tr><td colspan="5" class="loading">${escapeHtml(error.message)}</td></tr>`;
+        setFeedback(auditFeedback, error.message, "error");
+      }
+    }
+
+    function formatInteger(value) {
+      const number = Number(value || 0);
+      return Number.isFinite(number) ? number.toLocaleString() : "0";
+    }
+
+    function formatMicrosUsd(value, priced) {
+      if (!priced) return "Not configured";
+      const micros = Number(value || 0);
+      if (!Number.isFinite(micros)) return "—";
+      return `$${(micros / 1_000_000).toFixed(4)}`;
+    }
+
+    function renderUsage() {
+      if (!usageSummary) return;
+
+      usageRequests.textContent = formatInteger(usageSummary.totals.requests);
+      usageInputTokens.textContent = formatInteger(usageSummary.totals.inputTokens);
+      usageOutputTokens.textContent = formatInteger(usageSummary.totals.outputTokens);
+      usageCost.textContent = formatMicrosUsd(
+        usageSummary.totals.estimatedCostMicros,
+        usageSummary.pricingConfigured
+      );
+
+      if (!usageSummary.models.length) {
