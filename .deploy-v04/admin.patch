+          <tr>
+            <td>${escapeHtml(item.provider)}</td>
+            <td><strong>${escapeHtml(item.model)}</strong></td>
+            <td>${escapeHtml(formatInteger(item.requests))}</td>
+            <td>${escapeHtml(formatInteger(item.totalTokens))}</td>
+            <td>${escapeHtml(formatMicrosUsd(item.estimatedCostMicros, usageSummary.pricingConfigured))}</td>
