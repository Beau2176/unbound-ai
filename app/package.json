{
  "name": "unbound-ai",
  "version": "1.0.0",
  "description": "UNBOUND AI server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/validate-source.js",
    "security-check": "node scripts/security-contract.js",
    "regression-check": "node scripts/regression-contract.js",
    "ci": "npm run check && npm run security-check && npm run regression-check && npm audit --omit=dev --audit-level=moderate"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.1",
    "compression": "^1.8.2",
    "express": "^4.22.2",
    "openai": "^7.13.0",
    "pg": "^8.23.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
